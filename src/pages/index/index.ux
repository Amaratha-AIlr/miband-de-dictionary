  }

  .dd-rowm {
    font-size: 12px;
    color: #7a7a7a;
    margin-left: 8px;
  }

  .dd-empty {
    font-size: 14px;
    color: #7a7a7a;
    margin-top: 16px;
  }

  /* ---------- 详情页 ---------- */
  .dd-detailview {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .dd-card {
    width: 188px;
    flex-direction: column;
    margin: 12px 0px 0px 12px;
    padding: 12px;
    border-radius: 14px;
    background-color: #141414;
  }

  .dd-word {
    font-size: 24px;
    color: #ffffff;
  }

  .dd-resp {
    font-size: 14px;
    color: #9a9a9a;
    margin-top: 4px;
  }

  .dd-posrow {
    width: 100%;
    flex-direction: row;
    margin-top: 8px;
  }

  .dd-postag {
    font-size: 11px;
    color: #ffffff;
    padding: 3px 9px;
    border-radius: 9px;
    border: 1px solid #5a5a5a;
  }

  .dd-meaning {
    font-size: 16px;
    color: #e6e6e6;
    margin-top: 6px;
  }

  .dd-phrase {
    width: 124px;
    height: 34px;
    justify-content: center;
    align-items: center;
    margin: 14px 0px 0px 12px;
    border-radius: 17px;
    border: 1px solid #5a5a5a;
  }

  .dd-phraset {
    font-size: 13px;
    color: #cfcfcf;
  }

  .dd-nophrase {
    font-size: 11px;
    color: #6b6b6b;
    margin: 8px 0px 0px 14px;
  }

  .dd-phaselist {
    width: 188px;
    flex-direction: column;
    margin: 8px 0px 0px 12px;
  }

  .dd-phaserow {
    width: 100%;
    flex-direction: column;
    padding: 7px 9px;
    border-radius: 8px;
    background-color: #141414;
    margin-bottom: 4px;
  }

  .dd-phasew {
    font-size: 14px;
    color: #ffffff;
  }

  .dd-phasem {
    font-size: 11px;
    color: #8a8a8a;
    margin-top: 2px;
  }
</style>

<script>
import file from '@system.file'
import app from '@system.app'
import { createDict } from '../../common/scripts/dict.js'

export default {
  data: {
    view: 'home',
    query: '',
    rows: [],
    detail: null,
    phraseTip: '',
    version: '7.4.0',
    phraseRows: [],
    kbHidden: true,
    kbType: 'QWERTY',
    kbMaxLen: 24,
    kbVibrate: 'short',
    kbScreen: 'pill-shaped'
  },

  onInit() {
    this.dict = createDict(file)
    this.syncVersion()
    console.log('[DeDICT] ready')
  },

  /* 版本号从运行时读，避免 JS 常量与 manifest 漂移（曾经漏改过一次） */
  syncVersion() {
    const that = this
    try {
      app.getInfo({
        success: function (info) {
          if (info && info.versionName) {
            that.version = info.versionName
          }
        },
        fail: function () {}
      })
    } catch (e) {
      console.log('[DeDICT] getInfo 不可用，沿用常量')
    }
  },

  onDestroy() {
    this.dict = null
  },

  /* 分级返回：详情 → 列表 → 输入 → 首页 → 退出 */
  onBackPress() {
    if (this.view === 'detail') {
      this.backList()
      return true
    }
    if (this.view === 'list') {
      this.backInput()
      return true
    }
    if (this.view === 'about') {
      this.backHome()
      return true
    }
    if (this.view === 'input') {
      this.backHome()
      return true
    }
    return false
  },

  /* ---------- 导航 ---------- */
  openInput() {
    this.view = 'input'
    this.query = ''
    this.rows = []
    this.kbHidden = false
  },

  backHome() {
    this.view = 'home'
    this.query = ''
    this.rows = []
    this.kbHidden = true
  },

  backInput() {
    this.view = 'input'
    this.kbHidden = false
  },

  backList() {
    this.view = 'list'
    this.detail = null
    this.phraseTip = ''
  },

  showAbout() {
    this.view = 'about'
  },

  showPhrase() {
    const that = this
    const w = this.detail ? this.detail.word : ''
    if (!w) return
    this.phraseTip = '查询中…'
    this.dict.relatedPhrases(w, 8).then(function (list) {
      that.phraseRows = list || []
      that.phraseTip = (list && list.length) ? '' : '没有找到相关短语'
    }).catch(function (e) {
      that.phraseRows = []
      that.phraseTip = '短语查询出错'
      console.log('[DeDICT] phrase error: ' + (e && e.message ? e.message : e))
    })
  },

  /* ---------- 键盘事件 ---------- */
  onKbComplete(evt) {
    const content = evt && evt.detail && evt.detail.content
    if (!content) return
    if (this.query.length >= this.kbMaxLen) return
    this.query = this.query + content
  },

  onKbKeyDown(evt) {
    /* 仅记录，不参与拼接 */
  },

  onKbDelete() {
    if (!this.query) return
    this.query = this.query.substring(0, this.query.length - 1)
  },

  onKbVisibility(evt) {
    if (evt && evt.detail) {
      this.kbHidden = !evt.detail.visible
    }
  },

  onKbReady() {
    console.log('[DeDICT] keyboard ready')
  },

  /* ---------- 搜索 ---------- */
  doSearch() {
    const that = this
    const q = String(this.query || '').trim()
    if (!q) return
    this.kbHidden = true
    this.view = 'list'
    this.rows = []

    if (/[\u4e00-\u9fff]/.test(q)) {
      this.dict.searchZh(q).then(function (r) {
        const out = []
        const cands = (r && r.candidates) || []
        for (let i = 0; i < cands.length && out.length < 40; i++) {
          out.push({ word: cands[i], meaning: '' })
        }
        that.rows = out
      }).catch(function (e) {
        that.rows = []
        console.log('[DeDICT] zh error: ' + (e && e.message ? e.message : e))
      })
      return
    }

    this.dict.searchEn(q).then(function (en) {
      const out = []
      const seen = {}
      function push(word, meaning) {
        if (!word || seen[word]) return
        seen[word] = 1
        out.push({ word: word, meaning: meaning || '' })
      }
      if (en.exact) push(en.exact.word, en.exact.meaning)
      for (let i = 0; i < en.near.length; i++) push(en.near[i].word, en.near[i].meaning)
      that.rows = out.slice(0, 40)
    }).catch(function (e) {
      that.rows = []
      console.log('[DeDICT] en error: ' + (e && e.message ? e.message : e))
    })
  },

  /* ---------- 详情 ---------- */
  openDetail(word) {
    const that = this
    this.view = 'detail'
    this.detail = null
    this.phraseTip = ''
    this.phraseRows = []
    this.dict.getEntry(word).then(function (e) {
      that.detail = e || { word: word, pos: '', meaning: '没有找到释义', resp: '' }
    })
  }
}
</script>
