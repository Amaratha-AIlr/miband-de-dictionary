    font-size: 29px;
    color: #ffffff;
    margin-bottom: 22px;
  }

  .dd-searchbox {
    width: 176px;
    height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0px 14px;
    border-radius: 21px;
    border: 1px solid #4a4a4a;
    background-color: #141414;
  }

