<!-- De词典 v6 · 黑白设计 + 输入时搜索框居中

     配色：纯黑底 / 白色主字 / 灰色次字，无彩色
     开屏：图标 + 名称 + 署名（系统启动图关不掉，这里同底色衔接）
     输入：搜索框居中在键盘上方区域正中（不是贴顶栏）
     键盘：components/InputMethod（212×520 验证版，左右滑动显示全键）
-->
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="dd-page">

    <!-- ================= ① 首页（整体居中） ================= -->
    <div class="dd-home" if="{{view === 'home'}}">
      <image class="dd-homelogo" src="/common/images/deicon.png"></image>
      <text class="dd-title">DE词典</text>

      <div class="dd-searchbox" @click="openInput">
        <text class="dd-searchph">点击输入文本</text>
        <text class="dd-searchicon">⌕</text>
      </div>

      <text class="dd-about" @click="showAbout">关于</text>
    </div>

    <!-- ================= ①.5 关于页 ================= -->
    <div class="dd-aboutview" if="{{view === 'about'}}">
      <div class="dd-bar">
        <text class="dd-back" @click="backHome">‹</text>
        <text class="dd-bartitle">关于</text>
      </div>

      <div class="dd-aboutbody">
        <image class="dd-authors" src="/common/images/authors.png"></image>

        <text class="dd-motto">每个词背后，都有一整个世界。</text>

        <text class="dd-sign">Amarantha</text>
        <text class="dd-sign2">搭载 DSH 的 DeepSeek</text>

        <text class="dd-ver">v{{version}}</text>
      </div>
    </div>

    <!-- ================= ② 输入态（搜索框居中） ================= -->
    <div class="dd-inputview" if="{{view === 'input'}}">
      <text class="dd-back2" @click="backHome">‹</text>

      <div class="dd-ibox" @click="doSearch">
        <text class="dd-itext">{{query === '' ? '输入单词或中文' : query}}</text>
        <text class="dd-isearch">⌕</text>
      </div>

      <text class="dd-itip">输完点搜索框右边 ⌕</text>
    </div>

    <!-- ================= ③ 列表页 ================= -->
    <div class="dd-listview" if="{{view === 'list'}}">
      <div class="dd-bar">
        <text class="dd-back" @click="backInput">‹</text>
        <text class="dd-qtext">{{query}}</text>
        <text class="dd-count">{{rows.length}}</text>
      </div>

      <div class="dd-rows">
        <div class="dd-row" for="{{row in rows}}" @click="openDetail(row.word)">
          <text class="dd-roww">{{row.word}}</text>
          <text class="dd-rowm">{{row.meaning}}</text>
        </div>
        <text class="dd-empty" if="{{rows.length === 0}}">没找到相关单词</text>
      </div>
    </div>

    <!-- ================= ④ 详情页 ================= -->
    <div class="dd-detailview" if="{{view === 'detail'}}">
      <div class="dd-bar">
        <text class="dd-back" @click="backList">‹</text>
        <text class="dd-bartitle">详情</text>
      </div>

      <div class="dd-card" if="{{detail !== null}}">
        <text class="dd-word">{{detail.word}}</text>
        <text class="dd-resp" if="{{detail.resp !== ''}}">{{detail.resp}}</text>
        <div class="dd-posrow" if="{{detail.pos !== ''}}">
          <text class="dd-postag">{{detail.pos}}</text>
        </div>
        <text class="dd-meaning">{{detail.meaning}}</text>
      </div>

      <div class="dd-phrase" @click="showPhrase">
        <text class="dd-phraset">相关短语 {{phraseRows.length}}</text>
      </div>

      <div class="dd-phaselist" if="{{phraseRows.length > 0}}">
        <div class="dd-phaserow" for="{{p in phraseRows}}" @click="openDetail(p.word)">
          <text class="dd-phasew">{{p.word}}</text>
          <text class="dd-phasem">{{p.meaning}}</text>
        </div>
      </div>

      <text class="dd-nophrase" if="{{phraseTip !== ''}}">{{phraseTip}}</text>
    </div>

    <!-- ================= 键盘 ================= -->
    <input-method
      hide="{{kbHidden}}"
      keyboardtype="{{kbType}}"
      maxlength="{{kbMaxLen}}"
      vibratemode="{{kbVibrate}}"
      screentype="{{kbScreen}}"
      @visibility-change="onKbVisibility"
      @key-down="onKbKeyDown"
      @delete="onKbDelete"
      @complete="onKbComplete"
      @ready="onKbReady">
    </input-method>

  </div>
</template>

<style>
  .dd-page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  /* ---------- 开屏 ---------- */
  .dd-splash {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #000000;
  }

  .dd-splashlogo {
    width: 92px;
    height: 92px;
    border-radius: 20px;
  }

  .dd-splashtitle {
    font-size: 28px;
    color: #ffffff;
    margin-top: 16px;
  }

  .dd-splashline {
    font-size: 12px;
