    flex-direction: column;
    background-color: #000000;
  }

  .dd-rows {
    width: 100%;
    flex: 1;
    flex-direction: column;
    padding: 6px 8px;
    overflow: hidden;
  }

  .dd-row {
    width: 100%;
    height: 38px;
