    margin-top: 8px;
  }

  .dd-splashcredit {
    font-size: 10px;
    color: #6b6b6b;
    margin-top: 28px;
  }

  /* ---------- 首页 ---------- */
  .dd-home {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    padding-bottom: 8px;
  }

  .dd-homelogo {
    width: 76px;
    height: 76px;
    border-radius: 17px;
    margin-bottom: 14px;
  }

