    font-size: 13px;
    color: #8a8a8a;
  }

  .dd-searchicon {
    font-size: 18px;
    color: #ffffff;
  }

  .dd-about {
    font-size: 13px;
    color: #8a8a8a;
    margin-top: 26px;
  }

  .dd-abtip {
    font-size: 10px;
    color: #5a5a5a;
    margin-top: 6px;
  }

  /* ---------- 输入态：搜索框居中 ---------- */
  .dd-inputview {
    width: 100%;
    height: 215px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #000000;
  }

  .dd-back2 {
    position: absolute;
    left: 10px;
    top: 8px;
    font-size: 20px;
    color: #9a9a9a;
  }

  .dd-ibox {
    width: 178px;
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 14px;
    border-radius: 23px;
    border: 1px solid #6e6e6e;
    background-color: #141414;
  }

  .dd-itext {
    font-size: 15px;
    color: #ffffff;
    flex: 1;
  }

  .dd-isearch {
    font-size: 19px;
    color: #ffffff;
    margin-left: 6px;
  }

  .dd-itip {
    font-size: 11px;
    color: #5f5f5f;
    margin-top: 12px;
  }

  /* ---------- 关于页 ---------- */
  .dd-aboutview {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .dd-aboutbody {
    width: 100%;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 18px;
  }

  .dd-authors {
    width: 178px;
    height: 92px;
  }

  .dd-motto {
    font-size: 13px;
    color: #cfcfcf;
    margin-top: 14px;
    width: 186px;
    text-align: center;
  }

  .dd-sign {
    font-size: 15px;
    color: #ffffff;
    margin-top: 16px;
  }

  .dd-sign2 {
    font-size: 10px;
    color: #8a8a8a;
    margin-top: 3px;
  }

  .dd-ver {
    font-size: 10px;
    color: #5a5a5a;
    margin-top: 12px;
  }

  /* ---------- 通用顶栏 ---------- */
  .dd-bar {
    width: 100%;
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0px 8px;
    background-color: #111111;
  }

  .dd-back {
    font-size: 22px;
    color: #ffffff;
    width: 26px;
  }

  .dd-qtext {
    font-size: 16px;
    color: #ffffff;
    flex: 1;
  }

  .dd-count {
    font-size: 12px;
